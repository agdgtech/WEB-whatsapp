PORT=3000

# Dashboard admin login
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional: URL that receives incoming messages and status events as JSON POSTs
WEBHOOK_URL=

# Campaign throttling (milliseconds) - random delay between each message
MIN_DELAY_MS=8000
MAX_DELAY_MS=20000

# Max messages a single session sends per day through campaigns
DAILY_LIMIT_PER_SESSION=500
